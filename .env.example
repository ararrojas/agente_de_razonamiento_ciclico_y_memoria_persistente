# Copiá este archivo como ".env" y poné tu clave. ".env" no se sube (está en .gitignore).

# Proveedor: "google" (Gemini, por defecto), "anthropic" u "openai".
# Solo hace falta la clave del proveedor elegido.
LLM_PROVIDER="google"
GOOGLE_API_KEY="tu-clave-de-gemini"
ANTHROPIC_API_KEY="tu-clave-de-anthropic"
OPENAI_API_KEY="tu-clave-de-openai"

# Opcional: modelo (por defecto gemini-3.8-flash / claude-haiku-5-5 / gpt-4o-mini)
LLM_MODEL=""

# Solicitudes por minuto al LLM (0 = sin límite). El plan gratuito de Gemini
# permite 5 por minuto: con "4" el agente espera entre llamadas en vez de fallar.
LLM_RPM="4"

# Techo de pasos del grafo por turno (evita bucles infinitos y costos inesperados)
RECURSION_LIMIT="10"

# Memoria
CHECKPOINT_DB="data/memoria.sqlite"
# Si el historial supera esta cantidad de mensajes, se resumen los turnos viejos
UMBRAL_RESUMEN="14"
# Cuántos turnos recientes se conservan completos al resumir
TURNOS_A_CONSERVAR="2"
